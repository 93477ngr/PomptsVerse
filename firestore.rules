rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin role check: Checks known admin emails or user doc role in Firestore
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'localride369@gmail.com',
          'gangareddynaredla24925@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Prompts Collection - Publicly readable, writeable by signed-in creators & admins
    match /prompts/{promptId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.creatorId == request.auth.uid);
    }

    // Categories (public read, authenticated write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // AI Tools (public read, authenticated write)
    match /aiTools/{toolId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Collections (public read, authenticated write)
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Seasonal Campaigns (public read, authenticated write)
    match /seasonalCampaigns/{campaignId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Search Analytics
    match /searchAnalytics/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Sponsored Ads
    match /sponsoredAds/{adId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Ad Events
    match /adEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Site Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Blogs Collection
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Static Pages Collection
    match /staticPages/{pageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Media Library
    match /mediaLibrary/{mediaId} {
      allow read, write: if isSignedIn();
    }

    // Contact Form Submissions
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Site Configurations
    match /siteConfigs/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Admin Activity Logs
    match /adminLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    // Search Logs
    match /searchLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /likes/{likeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
