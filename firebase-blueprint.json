{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "AI prompt repository item",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "tool": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 1000 },
        "prompt": { "type": "string", "maxLength": 5000 },
        "negative": { "type": "string", "maxLength": 1000 },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "downloads": { "type": "number" },
        "creator": { "type": "string", "maxLength": 100 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "featured": { "type": "boolean" },
        "trending": { "type": "boolean" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] }
      },
      "required": ["title", "tool", "category", "prompt"]
    },
    "Category": {
      "title": "Category",
      "description": "Prompt categories",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 50 },
        "icon": { "type": "string", "maxLength": 50 },
        "count": { "type": "number" }
      },
      "required": ["name"]
    },
    "User": {
      "title": "User",
      "description": "User profile and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "email"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "User bookmarked prompts",
      "type": "object",
      "properties": {
        "promptId": { "type": "string", "maxLength": 128 }
      },
      "required": ["promptId"]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": { "$ref": "#/entities/Prompt" },
      "description": "Collection of all public and admin managed AI prompts"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Collection of categories"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "Subcollection of saved/bookmarked prompts for a user"
    }
  }
}
